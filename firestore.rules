rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function validText(value, max) { return value is string && value.size() > 0 && value.size() <= max; }
    function pairKey(a, b) { return a < b ? a + '_' + b : b + '_' + a; }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['displayName','email','createdAt','bio'])
        && validText(request.resource.data.displayName, 40);
      allow update: if signedIn() && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','bio','photoURL']);
      allow delete: if isAdmin();
    }

    match /users/{userId}/fcmTokens/{tokenId} {
      allow read, delete: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['token','createdAt'])
        && validText(request.resource.data.token, 4096);
    }

    match /publicProfiles/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['displayName','bio','photoURL','createdAt'])
        && validText(request.resource.data.displayName, 40)
        && (!('bio' in request.resource.data) || (request.resource.data.bio is string && request.resource.data.bio.size() <= 160))
        && (!('photoURL' in request.resource.data) || (request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 2000));
      allow update: if signedIn() && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','bio','photoURL'])
        && validText(request.resource.data.displayName, 40)
        && (!('bio' in request.resource.data) || (request.resource.data.bio is string && request.resource.data.bio.size() <= 160))
        && (!('photoURL' in request.resource.data) || (request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 2000));
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /friendRequests/{requestId} {
      allow read: if signedIn() && (resource.data.senderUid == request.auth.uid || resource.data.recipientUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.recipientUid is string
        && request.resource.data.recipientUid != request.auth.uid
        && request.resource.data.status == 'pending'
        && requestId == pairKey(request.resource.data.senderUid, request.resource.data.recipientUid)
        && request.resource.data.keys().hasOnly(['senderUid','senderName','recipientUid','recipientName','status','createdAt']);
      allow update: if signedIn()
        && resource.data.recipientUid == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['accepted','declined'];
      allow delete: if false;
    }

    match /friendships/{friendshipId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['senderUid','recipientUid','senderName','recipientName','members','createdAt'])
        && request.resource.data.senderUid is string
        && request.resource.data.recipientUid is string
        && request.resource.data.senderUid != request.resource.data.recipientUid
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.resource.data.members.hasAll([request.resource.data.senderUid, request.resource.data.recipientUid])
        && request.auth.uid in request.resource.data.members
        && friendshipId == pairKey(request.resource.data.senderUid, request.resource.data.recipientUid)
        && getAfter(/databases/$(database)/documents/friendRequests/$(friendshipId)).data.status == 'accepted'
        && getAfter(/databases/$(database)/documents/friendRequests/$(friendshipId)).data.senderUid == request.resource.data.senderUid
        && getAfter(/databases/$(database)/documents/friendRequests/$(friendshipId)).data.recipientUid == request.resource.data.recipientUid;
      allow update, delete: if false;
    }

    match /stories/{storyId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid','authorName','text','createdAt','expiresAt'])
        && request.resource.data.uid == request.auth.uid
        && validText(request.resource.data.text, 240)
        && validText(request.resource.data.authorName, 40)
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(24, 'h');
      allow update: if false;
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /groups/{groupId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name','description','createdBy','createdAt','visibility'])
        && request.resource.data.createdBy == request.auth.uid
        && validText(request.resource.data.name, 40)
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 160
        && request.resource.data.visibility == 'public';
      allow update: if false;
      allow delete: if isAdmin() || (signedIn() && resource.data.createdBy == request.auth.uid);

      match /members/{memberId} {
        allow read: if signedIn() && (request.auth.uid == memberId
          || get(/databases/$(database)/documents/groups/$(groupId)).data.visibility == 'public');
        allow create: if signedIn() && request.auth.uid == memberId
          && request.resource.data.keys().hasOnly(['uid','displayName','joinedAt'])
          && request.resource.data.uid == request.auth.uid
          && validText(request.resource.data.displayName, 40)
          && get(/databases/$(database)/documents/groups/$(groupId)).data.visibility == 'public';
        allow update: if false;
        allow delete: if isAdmin() || (signedIn() && request.auth.uid == memberId);
      }
    }

    match /posts/{postId} {
      allow read: if resource.data.status == 'published' || (signedIn() && resource.data.uid == request.auth.uid) || isAdmin();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid','authorName','text','createdAt','status','reportCount','likedBy','imageUrl','imagePath'])
        && request.resource.data.uid == request.auth.uid
        && (validText(request.resource.data.text, 1000)
          || ('imagePath' in request.resource.data && request.resource.data.text is string && request.resource.data.text.size() == 0))
        && request.resource.data.status == 'published'
        && request.resource.data.reportCount == 0
        && request.resource.data.likedBy is list
        && request.resource.data.likedBy.size() == 0
        && ((('imagePath' in request.resource.data) && ('imageUrl' in request.resource.data)
          && request.resource.data.imagePath is string
          && request.resource.data.imagePath.matches('post-images/' + request.auth.uid + '/.*')
          && request.resource.data.imageUrl is string
          && request.resource.data.imageUrl.size() <= 2000
          && request.resource.data.imageUrl.matches('https://firebasestorage.googleapis.com/.*'))
          || (!('imagePath' in request.resource.data) && !('imageUrl' in request.resource.data)));
      allow update: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text'])
        && validText(request.resource.data.text, 1000))
      || (signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy'])
        && request.resource.data.likedBy is list
        && request.resource.data.likedBy.size() <= resource.data.get('likedBy', []).size() + 1
        && request.resource.data.likedBy.size() >= resource.data.get('likedBy', []).size() - 1
        && ((request.resource.data.likedBy.hasAll(resource.data.get('likedBy', []))
          && request.resource.data.likedBy.size() == resource.data.get('likedBy', []).size() + 1
          && !resource.data.get('likedBy', []).hasAny([request.auth.uid])
          && request.resource.data.likedBy.hasAny([request.auth.uid]))
          || (resource.data.get('likedBy', []).hasAll(request.resource.data.likedBy)
          && request.resource.data.likedBy.size() == resource.data.get('likedBy', []).size() - 1
          && resource.data.get('likedBy', []).hasAny([request.auth.uid])
          && !request.resource.data.likedBy.hasAny([request.auth.uid]))));
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      match /comments/{commentId} {
        allow read: if get(/databases/$(database)/documents/posts/$(postId)).data.status == 'published';
        allow create: if signedIn()
          && get(/databases/$(database)/documents/posts/$(postId)).data.status == 'published'
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid','authorName','text','createdAt'])
          && validText(request.resource.data.text, 500)
          && validText(request.resource.data.authorName, 40);
        allow update: if false;
        allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      }
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['postId','reporterUid','reason','createdAt','status'])
        && validText(request.resource.data.reason, 300)
        && request.resource.data.status == 'open';
      allow read, update, delete: if isAdmin();
    }

    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants
        && exists(/databases/$(database)/documents/friendships/$(pairKey(resource.data.participants[0], resource.data.participants[1])));

      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.keys().hasOnly(['participants','createdAt','updatedAt'])
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants[0] < request.resource.data.participants[1]
        && chatId == pairKey(request.resource.data.participants[0], request.resource.data.participants[1])
        && exists(/databases/$(database)/documents/friendships/$(pairKey(request.resource.data.participants[0], request.resource.data.participants[1])));
      allow update: if signedIn() && request.auth.uid in resource.data.participants
        && exists(/databases/$(database)/documents/friendships/$(pairKey(resource.data.participants[0], resource.data.participants[1])))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage','updatedAt'])
        && (!('lastMessage' in request.resource.data) || validText(request.resource.data.lastMessage, 120));
      match /messages/{messageId} {
        allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && exists(/databases/$(database)/documents/friendships/$(chatId));
        allow create: if signedIn()
          && request.resource.data.senderUid == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && exists(/databases/$(database)/documents/friendships/$(chatId))
          && request.resource.data.keys().hasOnly(['senderUid','text','createdAt'])
          && validText(request.resource.data.text, 2000);
        allow update, delete: if false;
      }
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.recipientUid == request.auth.uid;
      allow update: if signedIn() && resource.data.recipientUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read is bool;
      allow create, delete: if isAdmin();
    }
  }
}