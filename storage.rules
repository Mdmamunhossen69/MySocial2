rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    match /user-avatars/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if signedIn() && request.auth.uid == userId
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if signedIn() && request.auth.uid == userId;
    }
    match /post-images/{userId}/{fileName} {
      allow read: if true;
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
      allow update: if false;
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == userId);
    }
  }
}
